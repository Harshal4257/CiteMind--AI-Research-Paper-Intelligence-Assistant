# Default: free local Hugging Face generation. The first run downloads model weights.
LLM_PROVIDER=local_huggingface
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_DEVICE=-1

# Optional hosted Hugging Face Inference Providers mode: set LLM_PROVIDER=huggingface_endpoint.
# Create a fine-grained token with “Make calls to Inference Providers” permission.
HUGGINGFACEHUB_API_TOKEN=
# Optional: avoids anonymous Hub download rate limits.
HF_TOKEN=

# These retrieval defaults reproduce the working notebook. Change only when intentionally experimenting.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TEMPERATURE=0.0
# `MAX_OUTPUT_TOKENS` is the preferred name; `MAX_NEW_TOKENS` remains supported for older .env files.
MAX_OUTPUT_TOKENS=256
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
INITIAL_RETRIEVAL_K=10
MIN_RELEVANCE_SCORE=0.15
RERANKING_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_QUERY_CHARS=2000
LOG_LEVEL=INFO


